{
 "type": "minecraft:multi_action",
 "title": {
  "text": "텔레포트 요청",
  "color": "gold",
  "bold": true
 },
 "columns": 1,
 "actions": [
  {
   "label": "확인",
   "width": 150,
   "action": {
    "type": "minecraft:dynamic/run_command",
    "template": "trigger tpa set $(v)"
   }
  }
 ],
 "exit_action": {
  "label": "닫기",
  "width": 150
 },
 "can_close_with_escape": true,
 "after_action": "close",
 "body": {
  "type": "minecraft:plain_message",
  "contents": "이동하고 싶은 상대의 ID를 입력하세요."
 },
 "inputs": [
  {
   "type": "minecraft:text",
   "key": "v",
   "label": "상대 ID",
   "initial": "1",
   "max_length": 9
  }
 ]
}