{
 "type": "minecraft:multi_action",
 "title": {
  "text": "동료 추가",
  "color": "gold",
  "bold": true
 },
 "columns": 1,
 "actions": [
  {
   "label": "확인",
   "width": 150,
   "action": {
    "type": "minecraft:dynamic/run_command",
    "template": "trigger trust set $(v)"
   }
  }
 ],
 "exit_action": {
  "label": "닫기",
  "width": 150
 },
 "can_close_with_escape": true,
 "after_action": "close",
 "body": {
  "type": "minecraft:plain_message",
  "contents": "동료로 추가할 사람의 ID를 입력하세요. 동료는 내 모든 땅에서 블록을 다룰 수 있고 출입 금지에도 걸리지 않습니다. ID는 메뉴 > 판매·경제 > 접속자·ID 목록에서 확인합니다."
 },
 "inputs": [
  {
   "type": "minecraft:text",
   "key": "v",
   "label": "동료 ID",
   "initial": "1",
   "max_length": 9
  }
 ]
}